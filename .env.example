# ─── GraphicAI · environment ──────────────────────────────────────────
# Copy this file to `.env` and fill in your Gemini API key.
# Get one (free tier available) at: https://aistudio.google.com/app/apikey
#
# This server-side key is used by default. If it runs out of quota, the
# UI prompts users to paste their own key — that key never touches the
# server and is stored in the user's browser localStorage.
# ──────────────────────────────────────────────────────────────────────

GEMINI_API_KEY=your_gemini_api_key_here
